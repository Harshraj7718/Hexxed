{
  "redirects": [
    {
      "source": "/products/:handle",
      "destination": "/product.html?p=:handle",
      "permanent": true
    },
    {
      "source": "/collections/:path*",
      "destination": "/products.html",
      "permanent": true
    },
    {
      "source": "/pages/contact",
      "destination": "/contact.html",
      "permanent": true
    },
    {
      "source": "/pages/faq",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/pages/about-us",
      "destination": "/story.html",
      "permanent": true
    },
    {
      "source": "/policies/privacy-policy",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/policies/refund-policy",
      "destination": "/refund.html",
      "permanent": true
    },
    {
      "source": "/policies/terms-of-service",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/policies/shipping-policy",
      "destination": "/shipping.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)-[A-Za-z0-9_-]{8}\\.(js|css|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}