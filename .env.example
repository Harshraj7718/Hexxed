# Copy to .env.local and fill in. Only PUBLIC values go here: anything starting with VITE_ is shipped to the browser.
# Never put the Admin API token or a private Storefront token in this project.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_token
VITE_SHOPIFY_API_VERSION=2026-10
# Optional: discount code added at checkout when the customer chooses "Pay online (prepaid)".
VITE_SHOPIFY_PREPAID_CODE=
